<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Notebook Report</title>
</head>
<body>
{% for title, cells in sections %}
<section class="label-group" data-label="{{ title }}">
  <h2>{{ title }}</h2>
  {% for cell in cells %}
  <section class="cell" data-cell-id="{{ cell.id }}" data-cell-type="{{ cell.cell_type }}">
    {% if cell.proposed_label %}
    <span class="label">{{ cell.proposed_label }}</span>
    {% endif %}
    <pre class="source">{{ cell.source }}</pre>
    {% set output = cell.outputs | output_text %}
    {% if output %}
    <pre class="output">{{ output }}</pre>
    {% endif %}
    {% if cell.stale %}
    <div class="gap-box" data-cell-id="{{ cell.id }}">Gap: {{ cell.reason }}</div>
    {% endif %}
  </section>
  {% endfor %}
</section>
{% endfor %}
</body>
</html>
